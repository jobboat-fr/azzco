{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/vigil",
      "destination": "/vigil.html"
    },
    {
      "source": "/vtlvs",
      "destination": "/vtlvs.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/fr/services",
      "destination": "/fr/services.html"
    },
    {
      "source": "/fr/vigil",
      "destination": "/fr/vigil.html"
    },
    {
      "source": "/fr/vtlvs",
      "destination": "/fr/vtlvs.html"
    },
    {
      "source": "/fr/jobboat",
      "destination": "/fr/jobboat.html"
    },
    {
      "source": "/fr/docs",
      "destination": "/fr/docs.html"
    },
    {
      "source": "/fr/contact",
      "destination": "/fr/contact.html"
    },
    {
      "source": "/mission",
      "destination": "/mission.html"
    },
    {
      "source": "/jobboat",
      "destination": "/jobboat.html"
    },
    {
      "source": "/invest",
      "destination": "/invest.html"
    },
    {
      "source": "/outwings",
      "destination": "/outwings.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/careers",
      "destination": "/careers.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/gdpr",
      "destination": "/gdpr.html"
    },
    {
      "source": "/zohoverify/verifyforzoho.html",
      "destination": "/zohoverify/verifyforzoho.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
